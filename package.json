{
  "name": "vite-project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run generate && npm run build:client && npm run build:server",
    "build:client": "tsgo -b && vite build --mode client",
    "build:server": "tsgo -b && vite build",
    "start": "node dist/index.js",
    "generate": "prisma generate",
    "postinstall": "npm run generate",
    "preinstall": "node ./scripts/check.mjs",
    "migrate:sql": "prisma migrate diff --from-empty --to-schema-datamodel ./prisma/schema.prisma --script > ./schema.sql",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@ant-design/icons": "6.x",
    "@hono/node-server": "^1.19.11",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/vite-dev-server": "^0.25.1",
    "@hono/zod-openapi": "^1.2.2",
    "@prisma/client": "6",
    "@tailwindcss/vite": "^4.2.1",
    "antd": "^6.3.6",
    "axios": "^1.16.0",
    "hono": "^4.12.7",
    "hono-history-api-fallback": "latest",
    "prisma": "6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.1",
    "vite-plugin-pages": "^0.33.3"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.10.0",
    "@rolldown/plugin-babel": "^0.1.7",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260312.1",
    "@vitejs/plugin-react": "^6.0.0",
    "babel-plugin-istanbul": "^7.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "globals": "^17.4.0",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "react-router-dom": "^7.13.1",
    "vite": "^8.0.0"
  }
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Note {
  id        String   @id @default(uuid())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pr_radar_note")
}

/// 运行期配置（键为 id）。其中 id = "GITHUB_PRIVATE_TOKEN" 存 GitHub PAT，供 PR 雷达请求 API。
model Infra {
  id        String   @id
  name      String
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pr_radar_infra_config")
}

/// 上游仓库在用户（Token 持有者）名下的 fork：`${org}-${repo}-${随机}`（存库可追溯，已存在则复用跳过创建）
model PrRadarUpstreamFork {
  id            String @id @default(uuid())
  upstreamOwner String
  upstreamRepo  String
  githubLogin   String // Token 持有者 login
  forkRepoName  String
  randomSuffix  String
  createdAt     DateTime @default(now())

  @@unique([upstreamOwner, upstreamRepo, githubLogin])
  @@map("pr_radar_upstream_fork")
}

/// PR 雷达：按仓库 + 目标分支 + 频率轮询，仅合并（merged_at 非空）的 PR 落库
model PrRadarWatchTask {
  id              String       @id @default(uuid())
  repositoryUrl   String
  owner           String
  repo            String
  branch          String
  intervalMinutes Int
  enabled         Boolean      @default(true)
  lastPolledAt    DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  mergedPrs       PrRadarMergedPr[]

  @@map("pr_radar_watch_task")
}

/// 已入库的合并 PR（按任务维度去重 githubPrNumber）
model PrRadarMergedPr {
  id             String           @id @default(uuid())
  taskId         String
  githubPrNumber Int
  title          String
  mergedAt       DateTime
  htmlUrl        String
  mergedByLogin  String?
  baseRef        String
  mergeCommitSha String?
  botBranchName  String?
  botBranchHtmlUrl String?
  botPushedAt    DateTime?
  botLastError   String?  @db.Text
  createdAt      DateTime         @default(now())
  task           PrRadarWatchTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, githubPrNumber])
  @@map("pr_radar_merged_pr")
}
